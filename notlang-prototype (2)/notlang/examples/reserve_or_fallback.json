{
  "mizan": "0.2",
  "label": "reserve_or_fallback",
  "context": "inventory",
  "params": {"product": "ProductId", "wanted": "Qty", "fallback": "Qty"},
  "returns": "Qty",
  "effects": ["db.read"],
  "nodes": {
    "product":     {"op": "param", "name": "product"},
    "wanted":      {"op": "param", "name": "wanted"},
    "fallback":    {"op": "param", "name": "fallback"},
    "none":        {"op": "const", "type": "Qty", "value": 0},
    "result":      {"op": "result"},
    "moves":       {"op": "db.scan", "table": "stock_moves"},
    "mine":        {"op": "filter_eq", "in": ["moves", "product"], "field": "product"},
    "qtys":        {"op": "pluck", "in": ["mine"], "field": "qty"},
    "on_hand":     {"op": "sum", "in": ["qtys"]},
    "enough":      {"op": "ge", "in": ["on_hand", "wanted"]},
    "left":        {"op": "sub", "in": ["on_hand", "wanted"]},
    "refuse":      {"op": "fail", "error": "OutOfStock", "type": "Qty",
                    "message": "not enough stock for this reservation"},
    "reserve":     {"op": "if", "in": ["enough", "left", "refuse"]},
    "safe":        {"op": "try", "in": ["reserve", "fallback"], "catch": "OutOfStock"},
    "wanted_ok":   {"op": "gt", "in": ["wanted", "none"]},
    "fallback_ok": {"op": "ge", "in": ["fallback", "none"]},
    "never_neg":   {"op": "ge", "in": ["result", "none"]}
  },
  "pre": ["wanted_ok", "fallback_ok"],
  "post": ["never_neg"],
  "out": "safe",
  "scenarios": [
    {"title": "Enough stock: returns what is left",
     "when": {"product": 1, "wanted": 5, "fallback": 99}, "then": {"result": 2}},
    {"title": "Exactly enough stock leaves nothing",
     "when": {"product": 1, "wanted": 7, "fallback": 99}, "then": {"result": 0}},
    {"title": "Not enough stock: the error is caught and the fallback is returned",
     "when": {"product": 1, "wanted": 8, "fallback": 99}, "then": {"result": 99}},
    {"title": "A zero fallback is allowed",
     "when": {"product": 1, "wanted": 8, "fallback": 0}, "then": {"result": 0}},
    {"title": "Zero units is a caller bug",
     "when": {"product": 1, "wanted": 0, "fallback": 99}, "then": {"error": "PRE_FAILED"}},
    {"title": "A negative fallback is a caller bug",
     "when": {"product": 1, "wanted": 5, "fallback": -1}, "then": {"error": "PRE_FAILED"}},
    {"title": "No stock history falls back",
     "given": {"stock_moves": []},
     "when": {"product": 99, "wanted": 1, "fallback": 99}, "then": {"result": 99}}
  ]
}
